# Explicit persistence backend. Production accepts postgres only.
EVENT_COMPANION_DATABASE_DRIVER=sqlite

# Local SQLite path. Keep the default database outside version control.
EVENT_COMPANION_DATABASE_PATH=.data/event-companion.sqlite

# Required when EVENT_COMPANION_DATABASE_DRIVER=postgres and by `npm run organizer:create`.
# DATABASE_URL=postgresql://user:password@localhost:5432/event_companion

# Production PostgreSQL requires a provider DNS hostname in DATABASE_URL; raw public
# IPv4/IPv6 endpoints are rejected so Node can verify the certificate hostname.
# DATABASE_CA_CERT is a secret: set the complete multiline root-CA PEM value, including
# BEGIN/END lines, not a filesystem path. Never commit a real certificate.
# DATABASE_CA_CERT=

# Optional PostgreSQL integration-test database. Tests skip when absent.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/event_companion_test

# Optional local-only organizer bearer token. Never commit a real value.
# This placeholder is ignored in production by design.
ORGANIZER_DEV_BEARER_TOKEN=replace-with-a-local-development-token

# Explicit non-production local-demo switch. `npm run dev:demo` sets this and
# binds the development server to 127.0.0.1. It is always denied in production.
EVENT_COMPANION_LOCAL_DEMO=false
